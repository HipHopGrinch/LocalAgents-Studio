{
  "name": "local-agents-ide",
  "version": "1.4.0",
  "description": "Distributed Local LLM Agent IDE for Windows",
  "author": "LocalAgents",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER=true electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:portable": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "dist:dir": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "check:electron": "tsc -p tsconfig.electron.json --noEmit && node scripts/check-electron.cjs",
    "test": "node scripts/run-selftests.cjs",
    "lint": "eslint src",
    "release": "node scripts/release.cjs"
  },
  "build": {
    "appId": "com.localagents.studio",
    "productName": "LocalAgents Studio",
    "copyright": "Copyright © LocalAgents",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/typescript/lib/typescript.js",
      "!node_modules/typescript/lib/tsserver.js",
      "!node_modules/typescript/lib/_tsserver.js",
      "!node_modules/typescript/lib/tsserverlibrary.js",
      "!node_modules/typescript/lib/typingsInstaller.js",
      "!node_modules/typescript/lib/_typingsInstaller.js",
      "!node_modules/typescript/lib/watchGuard.js",
      "!node_modules/typescript/lib/typesMap.json",
      "!node_modules/typescript/bin/tsserver",
      "!node_modules/typescript/lib/cs/**",
      "!node_modules/typescript/lib/de/**",
      "!node_modules/typescript/lib/es/**",
      "!node_modules/typescript/lib/fr/**",
      "!node_modules/typescript/lib/it/**",
      "!node_modules/typescript/lib/ja/**",
      "!node_modules/typescript/lib/ko/**",
      "!node_modules/typescript/lib/pl/**",
      "!node_modules/typescript/lib/pt-br/**",
      "!node_modules/typescript/lib/ru/**",
      "!node_modules/typescript/lib/tr/**",
      "!node_modules/typescript/lib/zh-cn/**",
      "!node_modules/typescript/lib/zh-tw/**"
    ],
    "onNodeModuleFile": "./scripts/pack-node-module-file.cjs",
    "asar": true,
    "afterPack": "./scripts/after-pack-fuses.cjs",
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LocalAgents-Studio-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "LocalAgents-Studio-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalAgents Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "LocalAgents-Studio-${version}-setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HipHopGrinch",
        "repo": "LocalAgents-Studio"
      }
    ]
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "typescript": "^5.7.3",
    "ws": "^8.22.1"
  }
}
